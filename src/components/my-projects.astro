				fill="#00D8FF"></path>
		</svg>
	</div>
</section>

<section class="interface-universe" aria-label="Interface design gallery">
	<div class="cosmic-stars" aria-hidden="true"></div>
	<div class="cosmic-streak cosmic-streak-one" aria-hidden="true"></div>
	<div class="cosmic-streak cosmic-streak-two" aria-hidden="true"></div>

	<header class="universe-heading">
		<div>
			<p>Apps/Webs archive</p>
			<h2>Ideas in orbit.</h2>
			<p class="universe-description">
				A little taste of my work and the apps/webs I had done.
			</p>
		</div>
	</header>

	<div class="ui-orbit-stage">
		<div class="interface-orb" aria-hidden="true">
			<div class="orb-core"></div>
		</div>
		<div class="orbit-ring orbit-ring-one" aria-hidden="true"></div>
		<div class="orbit-ring orbit-ring-two" aria-hidden="true"></div>

		<div class="ui-constellation">
			{
				projects.map((item, index) => (
					<figure
						class="ui-artifact"
						style={`--artifact-index: ${index}; --artifact-delay: -${index * 0.85}s`}
					>
						<img src={item.uri} alt={item.alt} loading="lazy" />
					</figure>
				))
			}
		</div>
	</div>

	<p class="swipe-hint">
		<Icon name="ph:arrow-right" size={18} />
		Swipe to explore all interfaces
	</p>
</section>
