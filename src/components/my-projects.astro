---
import { Icon } from "astro-icon/components";
import { PROJECTS_MOBILE, PROJECTS_WEB } from "@src/constants/slider-projects";

const storeLink =
	"inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-full border border-white/12 px-4 text-sm font-medium text-white transition-colors duration-500 ease-out";
const projects = [...PROJECTS_MOBILE, ...PROJECTS_WEB];
---

<section class="relative bg-[#101010] px-5 pt-40 pb-8 sm:px-8 md:pt-52">
	<div class="mx-auto max-w-6xl">
		<header class="mb-12 max-w-2xl md:mb-16">
			<div
				class="mb-5 flex items-center gap-3 text-xs font-medium tracking-[0.22em] text-blue-400 uppercase"
			>
				<span class="h-px w-8 bg-blue-400"></span>
				Selected work
			</div>
			<h2
				class="text-4xl font-medium tracking-[-0.045em] text-white sm:text-5xl md:text-6xl"
			>
				Products built for
				<span class="text-gray-500">real-world use.</span>
			</h2>
			<p class="mt-5 max-w-xl text-base leading-7 text-gray-400">
				From independent products to client platforms, every project is
				shaped around a clear problem and a useful outcome.
			</p>
		</header>

		<div class="grid gap-4 md:grid-cols-2">
			<article
				class="group relative overflow-hidden rounded-4xlrder border-blue-400/20 bg-[#14171c] p-7 md:col-span-2 md:min-h-120 md:p-12"
			>
				<div
					class="pointer-events-none absolute -top-24 -right-20 h-80 w-80 rounded-full bg-blue-500/12 blur-3xl transition-transform duration-700 group-hover:scale-125"
				>
				</div>
				<div
					class="relative flex h-full flex-col justify-between gap-16 md:flex-row md:items-end"
				>
					<div class="max-w-2xl">
						<div class="mb-8 flex items-center gap-2">
							<span
								class="rounded-full border border-blue-400/25 bg-blue-400/8 px-3 py-1.5 text-xs font-medium text-blue-300"
								>Featured product</span
							>
							<span
								class="rounded-full border border-white/10 px-3 py-1.5 text-xs text-gray-400"
								>iOS + Android</span
							>
						</div>
						<img
							class="mb-6 h-20 w-20 object-contain sm:h-24 sm:w-24"
							src="/flexmate/logo.png"
							alt="Flexmate logo"
							loading="lazy"
						/>
						<p class="mb-3 text-sm font-medium text-blue-400">
							Fitness companion
						</p>
						<h3
							class="customTitle text-6xl tracking-wide text-white sm:text-7xl md:text-8xl"
						>
							Flexmate
						</h3>
						<p
							class="mt-6 max-w-xl text-base leading-7 text-gray-300 sm:text-lg sm:leading-8"
						>
							Track every rep, organize workout routines and
							follow progress over time in a focused, multilingual
							training experience.
						</p>
					</div>

					<div
						class="grid w-full shrink-0 gap-2 sm:grid-cols-3 md:w-52 md:grid-cols-1"
					>
						<a
							class="inline-flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-white px-5 text-sm font-semibold text-black transition-colors duration-500 ease-out hover:bg-blue-100"
							href="https://valenciaarcega.com/flexmate/"
							target="_blank"
							rel="noopener noreferrer"
						>
							<Icon name="ph:globe-duotone" size={20} />
							Visit Website
							<Icon name="ph:arrow-up-right" size={16} />
						</a>
						<a
							class={`${storeLink} hover:border-blue-400/60 hover:bg-blue-400/8 hover:text-blue-200`}
							href="https://apps.apple.com/us/app/flexmate/id6788123810"
							target="_blank"
							rel="noopener noreferrer"
						>
							<Icon name="ph:app-store-logo-duotone" size={20} />
							App Store
						</a>
						<a
							class={`${storeLink} hover:border-blue-400/60 hover:bg-blue-400/8 hover:text-blue-200`}
							href="https://play.google.com/store/apps/details?id=app.valenciaarcega.flexmate"
							target="_blank"
							rel="noopener noreferrer"
						>
							<Icon
								name="ph:google-play-logo-duotone"
								size={20}
							/>
							Google Play
						</a>
					</div>
				</div>
			</article>

			<article
				class="group flex min-h-105 flex-col justify-between rounded-4xl border border-white/8 bg-[#141414] p-7 transition-colors duration-500 hover:border-amber-300/25 md:p-9"
			>
				<div>
					<div class="mb-8 flex items-start justify-between gap-6">
						<span
							class="text-xs font-medium tracking-[0.18em] text-gray-500 uppercase"
							>Client work</span
						>
						<div
							class="grid h-12 w-12 place-items-center rounded-full border border-white/10 text-amber-300"
						>
							<Icon name="ph:butterfly-duotone" size={32} />
						</div>
					</div>
					<h3
						class="text-3xl font-medium tracking-[-0.035em] text-white sm:text-4xl"
					>
						Enterprise AI Assistant
					</h3>
					<p
						class="mt-5 max-w-md text-sm leading-6 text-gray-400 sm:text-base sm:leading-7"
					>
						An AI assistant that understands company data and
						surfaces insights across sales, productivity, production
						and scrap.
					</p>
				</div>
				<footer
					class="mt-12 flex flex-wrap gap-2 border-t border-white/8 pt-6"
				>
					<a
						class={`${storeLink} hover:border-amber-300/60 hover:bg-amber-300/8 hover:text-amber-200`}
						href="https://apps.apple.com/mx/app/connie-ia/id6747147819"
						target="_blank"
						rel="noopener noreferrer"
					>
						<Icon name="ph:app-store-logo-duotone" size={20} />
						App Store
					</a>
					<a
						class={`${storeLink} hover:border-amber-300/60 hover:bg-amber-300/8 hover:text-amber-200`}
						href="https://play.google.com/store/apps/details?id=app.baaccsystems.connieia"
						target="_blank"
						rel="noopener noreferrer"
					>
						<Icon name="ph:google-play-logo-duotone" size={20} />
						Google Play
					</a>
				</footer>
			</article>

			<article
				class="group flex min-h-105 flex-col justify-between rounded-4xl border border-white/8 bg-[#141414] p-7 transition-colors duration-500 hover:border-emerald-300/25 md:p-9"
			>
				<div>
					<div class="mb-8 flex items-start justify-between gap-6">
						<span
							class="text-xs font-medium tracking-[0.18em] text-gray-500 uppercase"
							>Client work</span
						>
						<div
							class="grid h-12 w-12 place-items-center rounded-full border border-white/10 text-emerald-300"
						>
							<Icon name="ph:tote-duotone" size={32} />
						</div>
					</div>
					<h3
						class="text-3xl font-medium tracking-[-0.035em] text-white sm:text-4xl"
					>
						Freight Logistics Platform
					</h3>
					<p
						class="mt-5 max-w-md text-sm leading-6 text-gray-400 sm:text-base sm:leading-7"
					>
						A logistics app connecting freight holders with carriers
						across Mexico for safer, faster trips.
					</p>
				</div>
				<footer
					class="mt-12 flex flex-wrap gap-2 border-t border-white/8 pt-6"
				>
					<a
						class={`${storeLink} hover:border-emerald-300/60 hover:bg-emerald-300/8 hover:text-emerald-200`}
						href="https://apps.apple.com/mx/app/flego-tu-flete-de-regreso/id6746598808"
						target="_blank"
						rel="noopener noreferrer"
					>
						<Icon name="ph:app-store-logo-duotone" size={20} />
						App Store
					</a>
					<a
						class={`${storeLink} hover:border-emerald-300/60 hover:bg-emerald-300/8 hover:text-emerald-200`}
						href="https://play.google.com/store/apps/details?id=app.torreydlc.flego"
						target="_blank"
						rel="noopener noreferrer"
					>
						<Icon name="ph:google-play-logo-duotone" size={20} />
						Google Play
					</a>
				</footer>
			</article>
		</div>
	</div>
</section>

<section class="hidden">
	<div
		class="absolute inset-0 flex gap-y-3 flex-col items-center justify-center"
	>
		<svg
			class="spin-scale"
			viewBox="0 0 256 228"
			height={64}
			preserveAspectRatio="xMidYMid"
		>
			<path
				d="M210.483 73.824a171.49 171.49 0 0 0-8.24-2.597c.465-1.9.893-3.777 1.273-5.621 6.238-30.281 2.16-54.676-11.769-62.708-13.355-7.7-35.196.329-57.254 19.526a171.23 171.23 0 0 0-6.375 5.848 155.866 155.866 0 0 0-4.241-3.917C100.759 3.829 77.587-4.822 63.673 3.233 50.33 10.957 46.379 33.89 51.995 62.588a170.974 170.974 0 0 0 1.892 8.48c-3.28.932-6.445 1.924-9.474 2.98C17.309 83.498 0 98.307 0 113.668c0 15.865 18.582 31.778 46.812 41.427a145.52 145.52 0 0 0 6.921 2.165 167.467 167.467 0 0 0-2.01 9.138c-5.354 28.2-1.173 50.591 12.134 58.266 13.744 7.926 36.812-.22 59.273-19.855a145.567 145.567 0 0 0 5.342-4.923 168.064 168.064 0 0 0 6.92 6.314c21.758 18.722 43.246 26.282 56.54 18.586 13.731-7.949 18.194-32.003 12.4-61.268a145.016 145.016 0 0 0-1.535-6.842c1.62-.48 3.21-.974 4.76-1.488 29.348-9.723 48.443-25.443 48.443-41.52 0-15.417-17.868-30.326-45.517-39.844Zm-6.365 70.984c-1.4.463-2.836.91-4.3 1.345-3.24-10.257-7.612-21.163-12.963-32.432 5.106-11 9.31-21.767 12.459-31.957 2.619.758 5.16 1.557 7.61 2.4 23.69 8.156 38.14 20.213 38.14 29.504 0 9.896-15.606 22.743-40.946 31.14Zm-10.514 20.834c2.562 12.94 2.927 24.64 1.23 33.787-1.524 8.219-4.59 13.698-8.382 15.893-8.067 4.67-25.32-1.4-43.927-17.412a156.726 156.726 0 0 1-6.437-5.87c7.214-7.889 14.423-17.06 21.459-27.246 12.376-1.098 24.068-2.894 34.671-5.345.522 2.107.986 4.173 1.386 6.193ZM87.276 214.515c-7.882 2.783-14.16 2.863-17.955.675-8.075-4.657-11.432-22.636-6.853-46.752a156.923 156.923 0 0 1 1.869-8.499c10.486 2.32 22.093 3.988 34.498 4.994 7.084 9.967 14.501 19.128 21.976 27.15a134.668 134.668 0 0 1-4.877 4.492c-9.933 8.682-19.886 14.842-28.658 17.94ZM50.35 144.747c-12.483-4.267-22.792-9.812-29.858-15.863-6.35-5.437-9.555-10.836-9.555-15.216 0-9.322 13.897-21.212 37.076-29.293 2.813-.98 5.757-1.905 8.812-2.773 3.204 10.42 7.406 21.315 12.477 32.332-5.137 11.18-9.399 22.249-12.634 32.792a134.718 134.718 0 0 1-6.318-1.979Zm12.378-84.26c-4.811-24.587-1.616-43.134 6.425-47.789 8.564-4.958 27.502 2.111 47.463 19.8